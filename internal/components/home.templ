package components

import (
	"fmt"
	"strconv"

	"github.com/screwys/igloo/internal/home"
	"github.com/screwys/igloo/internal/model"
)

templ HomePage(p PageProps, data HomePageData) {
	@Base(p) {
		<div id="home-page" class="home-page" data-feed-route-content data-layout={ homeJSON(data.Layout) } data-default-layout={ homeJSON(home.DefaultLayout()) } data-widget-defaults={ homeJSON(homeWidgetDefaults()) }>
			<div class="home-heading">
				<h1>{ L(p, "nav_home", "Home") }</h1>
				<div class="home-heading-actions">
					@homeIconButton(p, "add", "Add", L(p, "home_add_widget", "Add widget"))
					<button type="button" class="home-icon-button" data-home-action="customize" aria-pressed="false" title={ L(p, "home_customize", "Customize") } aria-label={ L(p, "home_customize", "Customize") }>@MaterialIcon("GridView", "")</button>
					<button type="button" class="home-icon-button home-edit-only" data-home-action="save" title={ L(p, "action_save", "Save") } aria-label={ L(p, "action_save", "Save") }>@MaterialIcon("Check", "")</button>
					<button type="button" class="home-icon-button home-edit-only" data-home-action="cancel" title={ L(p, "action_cancel", "Cancel") } aria-label={ L(p, "action_cancel", "Cancel") }>@MaterialIcon("Close", "")</button>
				</div>
			</div>
			<div class="home-layout-toolbar home-edit-only">
				<label>{ L(p, "home_columns", "Columns") }<select class="input" data-home-layout="columns">
					for _, columns := range []int{1, 2, 3, 4, 5, 6} {
						<option value={ strconv.Itoa(columns) } selected={ columns == data.Layout.Columns }>{ strconv.Itoa(columns) }</option>
					}
				</select></label>
				<label>{ L(p, "home_spacing", "Spacing") }<select class="input" data-home-layout="spacing">
					<option value="comfortable" selected={ data.Layout.Spacing == "comfortable" }>{ L(p, "home_comfortable", "Comfortable") }</option>
					<option value="compact" selected={ data.Layout.Spacing == "compact" }>{ L(p, "home_compact", "Compact") }</option>
				</select></label>
				@homeIconButton(p, "reset", "Refresh", L(p, "home_reset", "Reset layout"))
			</div>
			<div id="shorts-grid-shell">
				<div id="feed-list">
					<div id="home-widgets" class={ "home-widgets", templ.KV("home-compact", data.Layout.Spacing == "compact") } style={ homeGridStyle(data.Layout) }>
						@HomeWidgets(p, data)
					</div>
				</div>
			</div>
			@homeDrawer(p, data)
		</div>
		<div id="shorts-layout" class="shorts-layout hidden" data-auto-open="0" data-persist-history="0" data-source-container-selector="#home-widgets" data-source-card-selector=".home-widget:not([data-home-type='continue']) a.video-card[data-shorts-eligible='1']" tabindex="-1">
			<div id="shorts-container" class="shorts-container"></div>
			<div id="shorts-uptodate-overlay" class="shorts-uptodate-overlay hidden"><div class="uptodate-content"><span>{ L(p, "status_up_to_date", "You're up to date!") }</span></div></div>
		</div>
	}
}

templ homeIconButton(p PageProps, action, icon, label string) {
	<button type="button" class="home-icon-button" data-home-action={ action } title={ label } aria-label={ label }>@MaterialIcon(icon, "")</button>
}

templ HomeWidgets(p PageProps, data HomePageData) {
	if len(data.Widgets) == 0 {
		<div class="home-empty"><button type="button" class="home-icon-button" data-home-action="add" title={ L(p, "home_add_widget", "Add widget") } aria-label={ L(p, "home_add_widget", "Add widget") }>@MaterialIcon("Add", "")</button></div>
	}
	for index, section := range data.Widgets {
		{{ widget := section.Widget }}
		<section class={ "home-widget", "home-size-" + widget.Size, "home-style-" + widget.Style, "home-layout-" + widget.Layout, templ.KV("home-hide-media", !widget.ShowMedia), templ.KV("home-hide-text", !widget.ShowText) } data-home-widget={ widget.ID } data-home-type={ widget.Type } style={ homeWidgetStyle(data.Layout.Columns, widget) } aria-label={ homeWidgetTitle(p, widget) }>
			<div class="home-widget-inner">
				<header class={ "home-widget-heading", templ.KV("home-header-hidden", !widget.ShowHeader) }>
					<span class="home-widget-symbol">@MaterialIcon(homeWidgetIcon(widget.Type), "")</span>
					<button type="button" class="home-icon-button home-drag-handle home-edit-only" data-home-action="drag" title={ L(p, "home_move_widget", "Move widget") } aria-label={ L(p, "home_move_widget", "Move widget") }>@MaterialIcon("Menu", "")</button>
					<h2>{ homeWidgetTitle(p, widget) }</h2>
					<div class="home-widget-actions">
						@homeIconButton(p, "configure", "MoreHoriz", L(p, "home_widget_settings", "Widget settings"))
					</div>
				</header>
				<div class="home-widget-body">
					if len(section.Items) == 0 {
						<div class="home-widget-empty">{ L(p, "home_no_items", "No items") }</div>
					} else if widget.Layout == "lanes" {
						<div class="home-lanes">
							for _, lane := range homeAccountLanes(section.Items) {
								<div class="home-account-lane">
									<a class="home-lane-heading" href={ templ.SafeURL("/channels/" + lane.ChannelID) } data-profile-channel-id={ lane.ChannelID }>
										if lane.AvatarURL != "" {
											<img src={ lane.AvatarURL } alt="" loading="lazy"/>
										}
										<span>{ lane.Name }</span>
									</a>
									<div class="home-items">
										for itemIndex, entry := range lane.Items {
											@homeEntry(p, data, widget, entry, itemIndex)
										}
									</div>
								</div>
							}
						</div>
					} else {
						<div class="home-items">
							for itemIndex, entry := range section.Items {
								@homeEntry(p, data, widget, entry, itemIndex)
							}
						</div>
					}
				</div>
				<footer class="home-widget-footer home-edit-only">
					<button type="button" class="home-icon-button" data-home-action="up" disabled={ index == 0 } title={ L(p, "home_move_earlier", "Move earlier") } aria-label={ L(p, "home_move_earlier", "Move earlier") }>@MaterialIcon("KeyboardArrowUp", "")</button>
					<button type="button" class="home-icon-button" data-home-action="down" disabled={ index == len(data.Widgets)-1 } title={ L(p, "home_move_later", "Move later") } aria-label={ L(p, "home_move_later", "Move later") }>@MaterialIcon("KeyboardArrowDown", "")</button>
					@homeIconButton(p, "resize", "OpenInFull", L(p, "home_resize", "Resize widget"))
					@homeIconButton(p, "duplicate", "ContentCopy", L(p, "home_duplicate", "Duplicate widget"))
					@homeIconButton(p, "remove", "Delete", L(p, "home_remove", "Remove widget"))
				</footer>
			</div>
		</section>
	}
}

templ homeEntry(p PageProps, data HomePageData, widget home.Widget, entry HomeEntry, index int) {
	<div class={ "home-entry", templ.KV("home-featured", index == 0 && widget.Layout == "feature"), templ.KV("home-post-entry", entry.Feed != nil) }>
		if entry.Feed != nil {
			if entry.CustomTitle != "" {
				<a class="home-saved-title" href={ templ.SafeURL("/thread/" + entry.Feed.TweetID) } data-feed-thread-open data-thread-tweet-id={ entry.Feed.TweetID }>{ entry.CustomTitle }</a>
			}
			@homeFeedCard(p, *entry.Feed)
		} else if entry.Broadcast != nil {
			@homeBroadcastCard(p, *entry.Broadcast, homeBroadcastChannel(data, *entry.Broadcast))
		} else {
			if entry.Video.RepostIntroduced {
				if label := model.RepostAuthorLabel(entry.Video.ReposterDisplayName, entry.Video.ReposterHandle); label != "" {
					<div class="home-repost-line">
						@MaterialIcon("Repeat", "")
						if entry.Video.ReposterChannelID != "" {
							<a href={ templ.SafeURL("/channels/" + entry.Video.ReposterChannelID) } data-profile-channel-id={ entry.Video.ReposterChannelID }>{ label }</a>
						} else {
							<span>{ label }</span>
						}
					</div>
				}
			}
			@VideoCard(p, entry.Video)
			if widget.Type == "continue" && entry.Video.PlaybackPosition > 0 {
				<div class="home-watch-progress" aria-label={ L(p, "home_progress", "Watch progress") }>
					<div class="home-progress-track"><span style={ fmt.Sprintf("width:%d%%;", progressPercent(entry.Video.PlaybackPosition, entry.Video.Duration)) }></span></div>
					<span>{ FormatDuration(int(entry.Video.PlaybackPosition)) }</span>
					if entry.Video.Duration > 0 {
						<span>{ " / " + FormatDuration(entry.Video.Duration) }</span>
					}
				</div>
			}
		}
	</div>
}

templ homeFeedCard(p PageProps, item model.FeedItem) {
		<article class="feed-card channel-row home-feed-card" data-feed-item data-tweet-id={ item.TweetID } data-feed-link={ feedExternalURL(item) } data-content-hash={ item.ContentHash } data-feed-is-retweet={ boolDataAttr(item.IsRetweet) } data-feed-seen={ boolDataAttr(item.IsSeen) } data-channel-id={ item.ChannelID } data-source-channel-id={ feedSourceChannelID(item) } data-liked={ boolDataAttr(item.IsLiked) } data-bookmarked={ boolDataAttr(item.IsBookmarked) } data-source-handle={ item.SourceHandle } data-author-handle={ item.AuthorHandle } data-quote-author-handle={ item.QuoteAuthorHandle } data-feed-author-channel-id={ item.ChannelID } data-feed-quote-tweet-id={ item.QuoteTweetID } data-feed-quote-author-channel-id={ item.QuoteChannelID } data-feed-retweeters={ retweetersChannelIDsJSON(item.Retweeters) } data-feed-date={ feedPublishedAtStr(item.PublishedAt) } data-feed-published={ feedPublishedAtStr(item.PublishedAt) } data-channel-name={ feedAuthorLabel(item) } data-channel-platform="twitter" data-media-count={ strconv.Itoa(len(item.Media)) } data-quote-media-count={ strconv.Itoa(len(item.QuoteMedia)) } data-tagged-accounts={ toJSONAttr(item.TaggedAccounts) }>
		if entries := repostEntries(item); len(entries) > 0 {
			@feedRepostLine(p, item, entries)
		}
		@feedHeader(p, item, feedAuthorLabel(item), isPureRepost(item))
			@homeFeedText(p, item.TweetID, item.ArticleTitle, item.BodyText, item.BodyTranslation, item.Lang, "body", 6)
		@homeFeedMedia(p, homeFeedPreviews(item.Media, item.MediaSlideURLs, item.MediaStreamURL, item.MediaPreviewURL))
		@feedContext(p, item.PollJSON, item.CommunityNote)
		if item.QuoteTweetID != "" {
			@homeFeedQuote(p, item)
		}
		if len(item.TaggedAccounts) > 0 {
			@feedTaggedAccounts(p, item)
		}
		if threadCapsuleVisible(item) {
			@feedThreadCapsule(p, item)
		}
		@feedActions(p, item)
		@feedFallbackForms(p, item)
	</article>
}

templ homeFeedQuote(p PageProps, item model.FeedItem) {
	<div class="feed-quote-card" data-quote-tweet-id={ item.QuoteTweetID } data-quote-author-channel-id={ item.QuoteChannelID } data-quote-author-handle={ item.QuoteAuthorHandle } data-quote-link={ safeExternalHTTPURL(item.QuoteCanonicalURL) } data-quote-liked={ boolDataAttr(item.QuoteIsLiked) } data-quote-bookmarked={ boolDataAttr(item.QuoteIsBookmarked) }>
		<div class="feed-quote-head">
			@feedAvatar(p, item.QuoteAuthorAvatarURL, feedQuoteLabel(item))
			if item.QuoteChannelID != "" {
				<a class="feed-quote-author" href={ templ.SafeURL("/channels/" + item.QuoteChannelID) }>{ feedQuoteLabel(item) }</a>
			} else {
				<span class="feed-quote-author">{ feedQuoteLabel(item) }</span>
			}
				if item.QuotePublishedAt != nil {
					<a class="feed-quote-date" href={ templ.SafeURL("/thread/" + item.QuoteTweetID) }>{ RelativeTimeText(p, item.QuotePublishedAt) }</a>
				}
				if hasQuoteTranslatePill(item) && (item.QuoteArticleTitle == "" || p.ArticleReader) {
					@feedTranslatePill(p, "quote", item.QuoteSourceLang, item.QuoteTranslation != "")
				}
			</div>
			@homeFeedText(p, item.TweetID, item.QuoteArticleTitle, item.QuoteBodyText, item.QuoteTranslation, item.QuoteLang, "quote", 4)
		@homeFeedMedia(p, homeFeedPreviews(item.QuoteMedia, item.QuoteMediaSlideURLs, item.QuoteMediaStreamURL, item.QuoteMediaPreviewURL))
		@feedContext(p, item.QuotePollJSON, item.QuoteCommunityNote)
	</div>
}

templ homeFeedText(p PageProps, tweetID, article, body, translation, lang, field string, lines int) {
	if article != "" {
		@feedArticleText(p, article, body, translation, tweetID, field, lang)
	} else if body != "" {
		<div class="feed-text-block" data-feed-text-container data-translate-field={ field } data-lang={ lang } data-target-lang={ translateTargetOrDefault(p.TranslateTargetLang) }
			if translation != "" {
				data-translated="1"
			}
		>
			<p class={ "feed-text-clamp", templ.KV("feed-body-text", field == "body"), templ.KV("feed-quote-text", field == "quote") } data-feed-text-clamp data-feed-clamp-lines={ strconv.Itoa(lines) }
				if translation != "" {
					data-original-text={ body }
				}
			>
				if translation != "" {
					@templ.Raw(Linkify(translation))
				} else {
					@templ.Raw(Linkify(body))
				}
			</p>
			<button class="feed-text-toggle hidden" type="button" data-feed-text-toggle aria-expanded="false">{ L(p, "action_read_more", "Read more") }</button>
		</div>
	}
}

templ homeFeedMedia(p PageProps, media []homeMediaPreview) {
	if len(media) > 0 {
		<div class={ "home-feed-media", "feed-media-wrap-grid", templ.KV("home-feed-gallery", len(media) > 1) }>
			for _, preview := range media {
				<button type="button" class="home-feed-preview feed-media-tile" data-feed-media data-feed-media-kind={ preview.Kind } data-feed-video-kind={ preview.PlaybackKind } data-feed-media-url={ preview.URL } data-feed-media-stream={ preview.StreamURL } data-feed-media-preview={ preview.PosterURL } aria-label={ L(p, "action_open_media", "Open media") }>
					if preview.PosterURL != "" {
						<img class="feed-media-image" src={ preview.PosterURL } loading="lazy" alt={ preview.AltText }/>
					}
					if preview.Kind == "video" {
						<span class="home-preview-play">@MaterialIcon("PlayCircle", "")</span>
					}
				</button>
			}
		</div>
	}
}

templ homeBroadcastCard(p PageProps, broadcast model.YouTubeBroadcast, channel model.Channel) {
	<div class="home-broadcast-card">
		<a class="home-broadcast-art" href={ templ.SafeURL(homeBroadcastHref(p, broadcast)) }>
			if broadcast.ThumbnailURL != "" {
				<img src={ broadcast.ThumbnailURL } alt="" loading="lazy"/>
			}
			<span class={ "home-live-badge", templ.KV("is-live", broadcast.LiveStatus == "is_live") }>{ homeBroadcastLabel(p, broadcast.LiveStatus) }</span>
			<span class="home-preview-play">@MaterialIcon("PlayCircle", "")</span>
		</a>
		<div class="home-broadcast-copy">
			<a class="home-broadcast-title" href={ templ.SafeURL(homeBroadcastHref(p, broadcast)) }>{ broadcast.Title }</a>
			<a class="home-broadcast-channel" href={ templ.SafeURL("/channels/" + channel.ChannelID) } data-profile-channel-id={ channel.ChannelID }>
				if channel.AvatarURL != "" {
					<img src={ channel.AvatarURL } alt="" loading="lazy"/>
				}
				<span>{ ChannelDisplayName(channel) }</span>
			</a>
			<div class="home-broadcast-meta">
				if broadcast.ConcurrentViewCount != nil && broadcast.LiveStatus == "is_live" {
					<span title={ L(p, "home_viewers", "Viewers") }>@MaterialIcon("Visibility", ""){ homeViewerCount(broadcast) }</span>
				}
				if at := homeBroadcastTime(broadcast); at != nil {
					<time datetime={ at.Format("2006-01-02T15:04:05Z07:00") } data-timestamp={ strconv.FormatInt(at.UnixMilli(), 10) }>{ RelativeTimeText(p, at) }</time>
				}
			</div>
		</div>
	</div>
}

templ homeDrawer(p PageProps, data HomePageData) {
	<dialog id="home-drawer" class="home-drawer" aria-labelledby="home-drawer-title">
		<header class="home-drawer-heading"><h2 id="home-drawer-title">{ L(p, "home_widget_settings", "Widget settings") }</h2>@homeIconButton(p, "close-drawer", "Close", L(p, "action_close", "Close"))</header>
		<div class="home-drawer-content">
			<div data-home-catalog>
				for _, kind := range home.Kinds {
					<button type="button" class="home-catalog-item" data-home-add={ kind.Type }>@MaterialIcon(homeWidgetIcon(kind.Type), "")<span>{ homeWidgetLabel(p, kind.Type) }</span>@MaterialIcon("Add", "")</button>
				}
			</div>
			<form data-home-settings hidden>
				<label class="home-field">{ L(p, "home_title", "Title") }<input class="input" name="title" type="text" autocomplete="off"/></label>
				<label class="home-field">{ L(p, "home_size", "Size") }<select class="input" name="size"><option value="small">{ L(p, "home_small", "Small") }</option><option value="medium">{ L(p, "home_medium", "Medium") }</option><option value="large">{ L(p, "home_large", "Large") }</option><option value="full">{ L(p, "home_full", "Full width") }</option></select></label>
				<label class="home-field">{ L(p, "home_layout", "Layout") }<select class="input" name="layout">
					<option value="feature">{ L(p, "home_feature", "Featured") }</option><option value="cards">{ L(p, "home_cards", "Cards") }</option><option value="list">{ L(p, "home_list", "List") }</option><option value="editorial">{ L(p, "home_editorial", "Editorial") }</option><option value="lanes">{ L(p, "home_lanes", "Account lanes") }</option><option value="portraits">{ L(p, "home_portraits", "Portraits") }</option>
				</select></label>
				<label class="home-field">{ L(p, "home_style", "Style") }<select class="input" name="style"><option value="surface">{ L(p, "home_surface", "Surface") }</option><option value="open">{ L(p, "home_open", "Open") }</option><option value="accent">{ L(p, "home_accent", "Accent") }</option></select></label>
				<label class="home-field">{ L(p, "home_item_count", "Items") }<input class="input" name="count" type="number" min="1" step="1"/></label>
				<label class="home-field" data-home-order>{ L(p, "home_order", "Order") }<select class="input" name="order"><option value="newest">{ L(p, "home_newest", "Newest") }</option><option value="recent">{ L(p, "home_recent", "Recently watched") }</option><option value="account">{ L(p, "home_by_account", "By account") }</option><option value="live">{ L(p, "home_live_first", "Live first") }</option></select></label>
				<fieldset class="home-field" data-home-platforms><legend>{ L(p, "home_platforms", "Platforms") }</legend><label class="home-check"><input type="checkbox" data-home-all="platforms"/>{ L(p, "logs_filter_all", "All") }</label><div class="home-checkbox-grid">
					for _, platform := range []string{"youtube", "twitter", "tiktok", "instagram"} {
						if p.PlatformsContain(platform) {
							<label class="home-check"><input type="checkbox" name="platforms" value={ platform }/>{ PlatformLabel(p, platform) }</label>
						}
					}
				</div></fieldset>
				<fieldset class="home-field" data-home-content-types><legend>{ L(p, "home_content", "Content") }</legend><label class="home-check"><input type="checkbox" data-home-all="content_types"/>{ L(p, "logs_filter_all", "All") }</label><div class="home-checkbox-grid">
					<label class="home-check"><input type="checkbox" name="content_types" value="post"/>{ L(p, "home_posts", "Posts") }</label><label class="home-check"><input type="checkbox" name="content_types" value="video"/>{ L(p, "home_videos", "Videos") }</label><label class="home-check"><input type="checkbox" name="content_types" value="image"/>{ L(p, "home_photos", "Photos") }</label><label class="home-check"><input type="checkbox" name="content_types" value="slideshow"/>{ L(p, "home_galleries", "Galleries") }</label><label class="home-check"><input type="checkbox" name="content_types" value="story"/>{ L(p, "home_stories", "Stories") }</label>
				</div></fieldset>
				<fieldset class="home-field" data-home-live-states><legend>{ L(p, "home_broadcasts", "Broadcasts") }</legend><label class="home-check"><input type="checkbox" data-home-all="live_states"/>{ L(p, "logs_filter_all", "All") }</label><div class="home-checkbox-grid"><label class="home-check"><input type="checkbox" name="live_states" value="is_live"/>{ L(p, "home_live", "Live") }</label><label class="home-check"><input type="checkbox" name="live_states" value="is_upcoming"/>{ L(p, "home_upcoming", "Upcoming") }</label><label class="home-check"><input type="checkbox" name="live_states" value="was_live"/>{ L(p, "home_replay", "Replay") }</label><label class="home-check"><input type="checkbox" name="live_states" value="post_live"/>{ L(p, "home_processing", "Processing") }</label></div></fieldset>
				<fieldset class="home-field"><legend>{ L(p, "home_display", "Display") }</legend>
					<label class="home-check"><input type="checkbox" name="show_header"/>{ L(p, "home_show_header", "Header") }</label><label class="home-check"><input type="checkbox" name="show_media"/>{ L(p, "home_show_media", "Media") }</label><label class="home-check"><input type="checkbox" name="show_text"/>{ L(p, "home_show_text", "Text") }</label><label class="home-check" data-home-starred-only><input type="checkbox" name="starred_only"/>{ L(p, "home_starred_only", "Starred accounts only") }</label>
				</fieldset>
				<fieldset class="home-field"><legend>{ L(p, "home_accounts", "Accounts") }</legend>
					<label class="home-check"><input type="checkbox" data-home-all="channels"/>{ L(p, "logs_filter_all", "All") }</label>
					<input type="search" class="input" data-home-account-search aria-label={ L(p, "channels_search_placeholder", "Search channels...") } placeholder={ L(p, "search_title", "Search") } autocomplete="off"/>
					<div class="home-account-list">
						for _, channel := range data.Channels {
							<label class="home-check home-account-choice" data-home-channel-search={ ChannelDisplayName(channel) + " " + ChannelDisplayHandle(channel) + " " + channel.Platform }>
								<input type="checkbox" name="channels" value={ channel.ChannelID }/>
								if channel.AvatarURL != "" {
									<img src={ channel.AvatarURL } alt="" loading="lazy"/>
								}
								<span>{ ChannelDisplayName(channel) }<small>{ PlatformLabel(p, channel.Platform) }</small></span>
							</label>
						}
					</div>
				</fieldset>
			</form>
		</div>
	</dialog>
}
