package components

import (
	"strings"

	"github.com/screwys/igloo/internal/model"
)

// FeedPage renders the full feed page (used for /feed and individual Twitter channel pages).
templ FeedPage(p PageProps, items []model.FeedItem, hasMore bool, nextPageURL string, showControls bool, serverReranked bool, xChannel *XChannelInfo, feedHeadAnchor string) {
	@Base(p) {
		<div id="feed-route-content" data-feed-route-content>
			if showControls {
				<div id="feed-toolbar" class="feed-toolbar"></div>
				@FeedNewPostsBar(p, false, feedHeadAnchor, nil)
			}
			if xChannel != nil && xChannel.Profile != nil {
				@ProfileCard(p, xChannel.Profile, "hero", xChannel.IsFollowing, xChannel.IsStarred)
			}
			if xChannel != nil {
				@XProfileContent(p, items, nextPageURL, showControls, serverReranked, xChannel)
			} else {
				@FeedList(p, items, nextPageURL, showControls, serverReranked)
			}
		</div>
		@RetweetersDialog(p)
	}
}

templ XProfileContent(p PageProps, items []model.FeedItem, nextPageURL string, showControls bool, serverReranked bool, xChannel *XChannelInfo) {
	<div class="x-profile-content">
		@XProfileTabs(p, xChannel)
		if xChannel.ActiveTab == "media" {
			@XProfileMediaGrid(p, items, xChannel.ChannelID)
		} else {
			@FeedList(p, items, nextPageURL, showControls, serverReranked)
		}
	</div>
}

templ FeedList(p PageProps, items []model.FeedItem, nextPageURL string, showControls bool, serverReranked bool) {
	<div
		id="feed-list"
		class="feed-list"
		style="display:flex; flex-direction:column; padding:1rem;"
		if serverReranked {
			data-server-reranked="1"
		}
		if showControls {
			data-seen-tracked="1"
		}
	>
		if len(items) > 0 {
			for _, item := range items {
				@FeedItem(p, item)
			}
		} else {
			<div class="empty-state"><h3>{ L(p, "feed_empty_title", "No posts") }</h3><p>{ L(p, "feed_empty_items", "No feed items available.") }</p></div>
		}
		@FeedScrollSentinel(nextPageURL)
	</div>
}

templ XProfileTabs(p PageProps, xChannel *XChannelInfo) {
	<div class="x-profile-tabs" role="tablist" aria-label={ L(p, "profile_content_tabs_aria", "Profile content") }>
		<a class={ xProfileTabClass(xChannel.ActiveTab, "posts") } href={ xProfileTabURL(xChannel.ChannelID, "posts") } role="tab" aria-selected={ boolDataAttr(xChannel.ActiveTab == "posts") }>{ L(p, "profile_posts", "Posts") }</a>
		<a class={ xProfileTabClass(xChannel.ActiveTab, "media") } href={ xProfileTabURL(xChannel.ChannelID, "media") } role="tab" aria-selected={ boolDataAttr(xChannel.ActiveTab == "media") }>{ L(p, "profile_media", "Media") }</a>
	</div>
}

templ XProfileMediaGrid(p PageProps, items []model.FeedItem, channelID string) {
	<div class="x-profile-media-grid" aria-label={ L(p, "profile_media", "Media") }>
		for _, item := range items {
			{{ thumbnail := xProfileMediaThumbnail(item) }}
			if thumbnail != "" {
				{{ authorLabel := feedAuthorLabel(item) }}
				<button
					class="x-profile-media-tile"
					type="button"
					data-feed-item
					data-x-profile-media
					data-feed-media
					data-tweet-id={ item.TweetID }
					data-feed-thread-href={ xProfileMediaPostHref(channelID, item.TweetID) }
					data-feed-link={ feedExternalURL(item) }
					data-content-hash={ item.ContentHash }
					data-feed-is-retweet={ boolDataAttr(item.IsRetweet) }
					data-liked={ boolDataAttr(item.IsLiked) }
					data-bookmarked={ boolDataAttr(item.IsBookmarked) }
					data-channel-id={ item.ChannelID }
					data-channel-name={ authorLabel }
					data-channel-platform="twitter"
					data-author-handle={ item.AuthorHandle }
					data-source-handle={ item.SourceHandle }
					data-feed-date={ feedPublishedAtStr(item.PublishedAt) }
					data-feed-media-kind={ item.Media[0].Type }
					data-feed-media-url={ feedMediaURLAt(item.MediaSlideURLs, 0) }
					aria-label={ L(p, "action_open_media", "Open media") }
				>
					<img src={ thumbnail } alt={ L(p, "feed_post_media", "Post media") } loading="lazy"/>
					if feedMediaRefIsVideo(item.Media[0]) {
						<span class="x-profile-media-video" aria-hidden="true">&#9654;</span>
					}
					<span class="x-profile-media-overlay-source" hidden>
						<span class="feed-author">{ authorLabel }</span>
						if item.AuthorHandle != "" {
							<span class="feed-author-handle">{ "@" + item.AuthorHandle }</span>
						}
						if item.BodyText != "" {
							<span class="feed-body-text">{ item.BodyText }</span>
						}
						for i, media := range item.Media {
							{{ slideURL := feedMediaURLAt(item.MediaSlideURLs, i) }}
							if slideURL != "" {
								{{ streamURL := item.MediaStreamURL }}
								if len(item.Media) > 1 || streamURL == "" || strings.HasPrefix(streamURL, "/api/media/slide/") {
									{{ streamURL = slideURL }}
								}
								<span
									data-x-profile-media-slide
									data-feed-media-kind={ media.Type }
									data-feed-media-url={ slideURL }
									if feedMediaRefIsVideo(media) && streamURL != "" {
										data-feed-media-stream={ streamURL }
										data-feed-media-preview={ slideURL }
									}
								></span>
							}
						}
					</span>
				</button>
			}
		}
	</div>
	if len(items) == 0 {
		<div class="empty-state"><h3>{ L(p, "profile_media_empty_title", "No media") }</h3><p>{ L(p, "profile_media_empty", "No original media posts found.") }</p></div>
	}
}

// LikedPage renders the liked posts page.
templ LikedPage(p PageProps, items []model.FeedItem, hasMore bool, nextPageURL string) {
	@Base(p) {
		<div id="feed-route-content" data-feed-route-content>
			<div
				id="feed-list"
				class="feed-list"
				style="display:flex; flex-direction:column; padding:1rem;"
			>
				if len(items) > 0 {
					for _, item := range items {
						@FeedItem(p, item)
					}
				} else {
					<div class="empty-state"><h3>{ L(p, "feed_empty_title", "No posts") }</h3><p>{ L(p, "feed_empty_items", "No feed items available.") }</p></div>
				}
				@FeedScrollSentinel(nextPageURL)
			</div>
		</div>
		@RetweetersDialog(p)
	}
}

// FeedScrollSentinel renders the HTMX infinite scroll trigger.
// When scrolled into view, it loads the next page and replaces itself.
templ FeedScrollSentinel(nextPageURL string) {
	if nextPageURL != "" {
		<div
			class="feed-scroll-sentinel"
			hx-get={ nextPageURL }
			hx-trigger="feed-preload"
			hx-swap="outerHTML"
		></div>
	}
}

// FeedItemsPartial renders just feed items for HTMX infinite scroll responses.
templ FeedItemsPartial(p PageProps, items []model.FeedItem) {
	for _, item := range items {
		@FeedItem(p, item)
	}
}

// RetweetersDialog renders the shared retweeters popup dialog.
templ RetweetersDialog(p PageProps) {
	<dialog id="retweeters-dialog" class="retweeters-dialog">
		<div class="retweeters-dialog-header">
			<h3>{ L(p, "feed_reposted_by", "Reposted by") }</h3>
			<button class="retweeters-dialog-close" type="button">&times;</button>
		</div>
		<ul class="retweeters-list"></ul>
	</dialog>
}

// FeedNewPostsBar polls /api/feed/head and shows when newly fetched feed rows
// arrive after the stable page anchor. When visible, it shows up to three
// overlapping avatars of the highest-ranked new posters, X-style.
templ FeedNewPostsBar(p PageProps, hasNew bool, anchorTweetID string, avatars []model.NewPosterAvatar) {
	<button
		id="feed-new-posts-bar"
		class={ "feed-new-posts-bar", templ.KV("hidden", !hasNew) }
		type="button"
		data-feed-head-anchor={ anchorTweetID }
		aria-label={ L(p, "action_show_new_posts", "Show new posts") }
		data-i18n-aria-label="action_show_new_posts"
		hx-get="/api/feed/head?fmt=html"
		hx-trigger="every 9s [!document.hidden]"
		hx-swap="outerHTML"
		hx-vals={ `js:{known_head: (document.getElementById("feed-new-posts-bar")?.getAttribute("data-feed-head-anchor") || "")}` }
		onclick="window.location.assign('/feed')"
	>
		<svg class="feed-new-posts-arrow" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M12 4 L12 20 M5 11 L12 4 L19 11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
		if len(avatars) > 0 {
			<span class="feed-new-posts-avatars">
				for _, a := range avatars {
					<img
						class="feed-new-posts-avatar"
						src={ a.AuthorAvatarURL }
						alt={ a.AuthorHandle }
						loading="lazy"
						onerror="this.style.visibility='hidden'"
					/>
				}
			</span>
			<span class="feed-new-posts-label">{ L(p, "feed_new_posts_posted", "posted") }</span>
		} else {
			<span class="feed-new-posts-label">{ L(p, "feed_new_posts", "New posts") }</span>
		}
	</button>
}
