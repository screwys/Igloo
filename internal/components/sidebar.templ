package components

import (
	"fmt"
	"strings"

	"github.com/screwys/igloo/internal/model"
)

// Sidebar renders the full sidebar navigation panel.
templ Sidebar(p PageProps) {
	<aside class="sidebar" id="app-sidebar">
		<div class="sidebar-header">
			<a href="/videos" class="logo" aria-label={ L(p, "app_name", "Igloo") } data-i18n-aria-label="app_name">
				<img class="logo-icon" src={ p.StaticV("favicon.svg") } alt="" aria-hidden="true"/>
				<span data-i18n="app_name">{ L(p, "app_name", "Igloo") }</span>
			</a>
		</div>
		<nav class="nav">
			for _, route := range sidebarRouteOrder(p.Prefs.Str("sidebar_route_order", "")) {
				if route == "discover" && p.PlatformsContain("youtube") {
					@SidebarDiscoverNavItem(p)
				}
				if route == "videos" && p.PlatformsContain("youtube") {
				<a href="/videos" class={ "nav-item", templ.KV("active", p.ActiveNav == "videos") } data-sidebar-nav-route="videos" title={ L(p, "nav_videos", "Videos") } aria-label={ L(p, "nav_videos", "Videos") }>
					@MaterialIcon("VideoLibrary", "nav-icon")
					<span data-i18n="nav_videos">{ L(p, "nav_videos", "Videos") }</span>
				</a>
				}
				if route == "feed" && p.PlatformsContain("twitter") {
				<a href="/feed" class={ "nav-item", templ.KV("active", p.ActiveNav == "feed") } data-sidebar-nav-route="feed" title={ L(p, "nav_feed", "Feed") } aria-label={ L(p, "nav_feed", "Feed") }>
					@MaterialIcon("DynamicFeed", "nav-icon")
					<span data-i18n="nav_feed">{ L(p, "nav_feed", "Feed") }</span>
				</a>
			}
				if route == "shorts" && (p.PlatformsContain("tiktok") || p.PlatformsContain("instagram")) {
				<a href="/shorts" class={ "nav-item", templ.KV("active", p.ActiveNav == "shorts") } data-sidebar-nav-route="shorts" title={ L(p, "nav_moments", "Moments") } aria-label={ L(p, "nav_moments", "Moments") }>
					@MaterialIcon("PlayCircle", "nav-icon")
					<span data-i18n="nav_moments">{ L(p, "nav_moments", "Moments") }</span>
				</a>
			}
				if route == "channels" {
				<a href="/channels" class={ "nav-item", templ.KV("active", p.ActiveNav == "channels") } data-sidebar-nav-route="channels" title={ L(p, "nav_channels", "Channels") } aria-label={ L(p, "nav_channels", "Channels") }>
				@MaterialIcon("GridView", "nav-icon")
				<span data-i18n="nav_channels">{ L(p, "nav_channels", "Channels") }</span>
			</a>
				}
				if route == "bookmarks" {
				<a href="/bookmarks" class={ "nav-item", templ.KV("active", p.ActiveNav == "bookmarks") } data-sidebar-nav-route="bookmarks" title={ L(p, "nav_bookmarks", "Bookmarks") } aria-label={ L(p, "nav_bookmarks", "Bookmarks") }>
				@MaterialIcon("Bookmark", "nav-icon")
				<span data-i18n="nav_bookmarks">{ L(p, "nav_bookmarks", "Bookmarks") }</span>
			</a>
				}
				if route == "liked" && p.PlatformsContain("twitter") {
				<a href="/liked" class={ "nav-item", templ.KV("active", p.ActiveNav == "liked") } data-sidebar-nav-route="liked" title={ L(p, "nav_liked", "Liked") } aria-label={ L(p, "nav_liked", "Liked") }>
					@MaterialIcon("Favorite", "nav-icon")
					<span data-i18n="nav_liked">{ L(p, "nav_liked", "Liked") }</span>
				</a>
				}
			}
		</nav>
		<div class="sidebar-compact-actions">
			<button class="sidebar-compact-btn" type="button" data-sidebar-compact-add title={ L(p, "action_add_channel", "Add Channel") } aria-label={ L(p, "action_add_channel", "Add Channel") } data-i18n-title="action_add_channel" data-i18n-aria-label="action_add_channel">
				@MaterialIcon("Add", "")
			</button>
			<button class="sidebar-compact-btn" type="button" data-sidebar-compact-download title={ L(p, "action_download", "Download") } aria-label={ L(p, "action_download", "Download") } data-i18n-title="action_download" data-i18n-aria-label="action_download">
				@MaterialIcon("Download", "")
			</button>
			<button class="sidebar-compact-btn" type="button" data-sidebar-compact-logs title={ L(p, "action_view_logs", "View logs") } aria-label={ L(p, "action_view_logs", "View logs") } data-i18n-title="action_view_logs" data-i18n-aria-label="action_view_logs">
				@MaterialIcon("Subject", "")
			</button>
		</div>
		if len(p.Sidebar.CurrentlyWatching) > 0 {
			@SidebarVideoList(L(p, "sidebar_continue_watching", "Continue Watching"), p.Sidebar.CurrentlyWatching, p.Prefs)
		}
		if len(p.Sidebar.CurrentlyAvailable) > 0 {
			@SidebarVideoList(L(p, "sidebar_currently_available", "Currently Available"), p.Sidebar.CurrentlyAvailable, p.Prefs)
		}
		if len(p.Sidebar.PinnedVideos) > 0 {
			@SidebarVideoList(L(p, "sidebar_pinned_videos", "Pinned Videos"), p.Sidebar.PinnedVideos, p.Prefs)
		}
		<div class="filter-row">
			<div class="clearable-input">
				<input id="platform-search" class="platform-search-input" type="text" placeholder={ L(p, "sidebar_channel_filter_placeholder", "Filter channels...") } data-i18n-placeholder="sidebar_channel_filter_placeholder" autocomplete="off" spellcheck="false"/>
				<button type="button" class="input-clear-btn hidden" data-clear-for="platform-search" aria-label={ L(p, "action_clear", "Clear") } data-i18n-aria-label="action_clear">@MaterialIcon("Close", "")</button>
			</div>
			<button
				class="sidebar-add-btn"
				type="button"
				title={ L(p, "action_add_channel", "Add Channel") }
				aria-label={ L(p, "action_add_channel", "Add Channel") }
				data-i18n-title="action_add_channel"
				data-i18n-aria-label="action_add_channel"
				onclick="var m=document.getElementById('add-sub-modal');if(m){m.classList.remove('hidden');m.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';var s=document.getElementById('add-sub-status');if(s)s.innerHTML='';var i=document.getElementById('sub-input');if(i){requestAnimationFrame(function(){i.focus();i.select()})}}"
			>@MaterialIcon("Add", "")</button>
		</div>
		<div class="sidebar-scroll">
			<div class="sidebar-section">
				<div id="channel-list" class="channel-list">
					for _, g := range p.Sidebar.Groups {
						@ChannelGroupRender(p, g, !sidebarGroupDeferred(g))
					}
				</div>
			</div>
		</div>
		<div class="sidebar-footer">
			@sidebarQuickDownloadForm(p, "quick-dl-input", "quick-dl-status")
			<div class="sidebar-status"
				id="sidebar-status"
				hx-get="/api/sidebar-status"
				hx-trigger="load, every 4s [!document.hidden], poll"
				hx-swap="innerHTML"
			>
				<div class="status-activity">
					<div class="status-dot"></div>
					<div class="status-activity-lines">
						<span class="status-secondary-text" data-i18n="status_loading">{ L(p, "status_loading", "Loading...") }</span>
					</div>
					<button id="status-log-btn" class="status-log-btn" type="button" aria-label={ L(p, "action_view_logs", "View logs") } data-i18n-aria-label="action_view_logs">
						@MaterialIcon("Subject", "")
					</button>
				</div>
			</div>
		</div>
		<div
			id="sidebar-resize-handle"
			class="sidebar-resize-handle"
			role="separator"
			tabindex="0"
			aria-orientation="vertical"
			aria-valuemin="72"
			aria-valuemax="420"
			aria-valuenow="320"
			title={ L(p, "action_resize_sidebar", "Resize sidebar") }
			aria-label={ L(p, "action_resize_sidebar", "Resize sidebar") }
			data-i18n-title="action_resize_sidebar"
			data-i18n-aria-label="action_resize_sidebar"
		></div>
	</aside>
	<div id="quick-download-modal" class="modal hidden" aria-hidden="true">
		<div class="modal-backdrop"></div>
		<div class="modal-content quick-download-modal-content">
			<div class="modal-header">
				<h2>{ L(p, "action_download", "Download") }</h2>
				<button class="modal-close" type="button" aria-label={ L(p, "action_close", "Close") } data-i18n-aria-label="action_close">@MaterialIcon("Close", "")</button>
			</div>
			@sidebarQuickDownloadForm(p, "compact-quick-dl-input", "compact-quick-dl-status")
		</div>
	</div>
}

templ SidebarDiscoverNavItem(p PageProps) {
	<a href="/discover" class={ "nav-item", templ.KV("active", p.ActiveNav == "discover") } data-sidebar-nav-route="discover" title={ L(p, "nav_discover", "Discover") } aria-label={ L(p, "nav_discover", "Discover") }>
		@MaterialIcon("Explore", "nav-icon")
		<span>{ L(p, "nav_discover", "Discover") }</span>
	</a>
}

templ sidebarQuickDownloadForm(p PageProps, inputID string, statusID string) {
	<form class="quick-download"
		hx-post="/api/quick-download"
		hx-target={ "#" + statusID }
		hx-swap="innerHTML"
		hx-on::before-request="var b=this.querySelector('.quick-dl-icon');if(!b.dataset.idleIcon)b.dataset.idleIcon=b.innerHTML;b.className='quick-dl-icon downloading';b.textContent='⟳';this.querySelector('.quick-dl-status').className='quick-dl-status hidden'"
		hx-on::after-request="var b=this.querySelector('.quick-dl-icon'),s=this.querySelector('.quick-dl-status'),result=s.querySelector('[data-download-success]'),ok=result?result.dataset.downloadSuccess==='true':event.detail.successful;b.className='quick-dl-icon '+(ok?'success':'error');b.textContent=ok?'✓':'✕';s.className='quick-dl-status';if(ok)this.querySelector('.quick-download-bar .input').value='';setTimeout(function(){b.className='quick-dl-icon';b.innerHTML=b.dataset.idleIcon},3000)"
	>
		<div class="quick-download-bar">
			<input type="text" name="url" id={ inputID } class="input" autocomplete="off" placeholder={ L(p, "download_url_placeholder", "Paste URL to download...") } data-i18n-placeholder="download_url_placeholder"/>
			<button class="quick-dl-icon" type="submit" title={ L(p, "action_download", "Download") } data-i18n-title="action_download">@MaterialIcon("Download", "")</button>
		</div>
		<div id={ statusID } class="quick-dl-status hidden"></div>
	</form>
}

func sidebarGroupI18nKey(g model.ChannelGroup) string {
	switch g.GroupID {
	case "favourites", "starred":
		return "drawer_starred"
	case "other":
		return "drawer_other"
	default:
		return ""
	}
}

func sidebarGroupTitle(p PageProps, g model.ChannelGroup) string {
	if key := sidebarGroupI18nKey(g); key != "" {
		return L(p, key, g.Title)
	}
	return g.Title
}

func sidebarGroupCount(g model.ChannelGroup) int {
	if g.Count > 0 {
		return g.Count
	}
	return len(g.Channels)
}

func sidebarGroupDeferred(g model.ChannelGroup) bool {
	if g.StarIcon || g.GroupID == "favourites" || g.GroupID == "starred" {
		return false
	}
	return g.Collapsed && sidebarGroupCount(g) > 0
}

// ChannelGroupRender renders a single channel group in the sidebar.
templ ChannelGroupRender(p PageProps, g model.ChannelGroup, renderItems bool) {
	<div
		class={ "channel-group", templ.KV("collapsed", g.Collapsed) }
		id={ fmt.Sprintf("group-%s", g.GroupID) }
		data-group-id={ g.GroupID }
		if !renderItems {
			data-sidebar-deferred="1"
			data-sidebar-load-url={ "/api/sidebar/channels?group=" + g.GroupID }
		}
	>
		<div class="channel-group-header" data-channel-group-toggle data-group-id={ g.GroupID }>
			<div style="display:flex; align-items:center; gap:5px;">
				if key := sidebarGroupI18nKey(g); key != "" {
					<span data-i18n={ key }>{ sidebarGroupTitle(p, g) }</span>
				} else {
					<span>{ sidebarGroupTitle(p, g) }</span>
				}
				<span class="channel-group-count">{ fmt.Sprintf("%d", sidebarGroupCount(g)) }</span>
			</div>
			<div style="display:flex; align-items:center; gap:10px;">
				if g.PlatformKey != "" {
					<button class="nav-refresh-btn" type="button" title={ LF(p, "action_refresh_group", "Refresh %1$s", sidebarGroupTitle(p, g)) }
						hx-post={ "/api/platform/" + g.PlatformKey + "/refresh" }
						hx-swap="none"
						hx-on::before-request="this.classList.add('spinning')"
						hx-on::after-request="var b=this;setTimeout(function(){b.classList.remove('spinning')},800)"
					>@MaterialIcon("Refresh", "")</button>
				}
				<span class="chevron">@MaterialIcon("KeyboardArrowRight", "")</span>
			</div>
		</div>
		<div class="channel-list" data-sidebar-group-items>
			if renderItems {
				@SidebarChannelItems(p, g.Channels)
			}
		</div>
	</div>
}

templ SidebarChannelItems(p PageProps, channels []model.Channel) {
	for _, ch := range channels {
		@SidebarChannelItem(p, ch)
	}
}

// SidebarChannelItem renders a single channel item in the sidebar.
templ SidebarChannelItem(p PageProps, ch model.Channel) {
	<div class="channel-item" data-channel-id={ ch.ChannelID } data-channel-name={ ChannelDisplayName(ch) } data-channel-handle={ ChannelDisplayHandle(ch) } data-channel-platform={ ch.Platform }>
		<a href={ templ.SafeURL(fmt.Sprintf("/channels/%s", ch.ChannelID)) } class="channel-item-link" data-id={ ch.ChannelID }>
			<img class="channel-avatar-img" src={ ch.AvatarURL } alt="" loading="lazy" onload="window.MpaSiteBase&&window.MpaSiteBase.avatarLoad(this)" onerror="if(window.MpaSiteBase&&window.MpaSiteBase.avatarError(this))return; this.style.display='none'; this.nextElementSibling.style.display='flex';"/>
			<div class="channel-avatar" style="display:none;">{ strings.ToUpper(FirstChar(ChannelDisplayName(ch))) }</div>
			<div class="channel-name-row">
				<div class="channel-name" title={ channelNameTitle(ch) }>{ ChannelDisplayName(ch) }</div>
				if handle := ChannelDisplayHandle(ch); handle != "" {
					<span class="channel-handle" title={ "@" + handle }>{ "@" + handle }</span>
				}
					if label := PlatformLabel(p, ch.Platform); label != "" {
						<span class={ "channel-platform-label", "plat-" + ch.Platform }>{ label }</span>
					}
			</div>
		</a>
		<div class="channel-actions">
			@SidebarStarButton(p, ch.ChannelID, ch.IsStarred)
			<button class="channel-btn refresh" type="button" title={ L(p, "action_refresh_channel", "Update/Refresh") } data-i18n-title="action_refresh_channel"
				hx-post={ "/api/channels/" + ch.ChannelID + "/refresh" }
				hx-swap="none"
				hx-on::before-request="this.dataset.idleIcon=this.innerHTML;this.textContent='…';this.disabled=true"
				hx-on::after-request="var b=this;b.textContent=event.detail.successful?'✓':'!';setTimeout(function(){b.innerHTML=b.dataset.idleIcon;b.disabled=false},1200)"
			>@MaterialIcon("Refresh", "")</button>
			<button class="channel-btn settings" type="button" title={ L(p, "action_channel_settings_short", "Settings") } data-i18n-title="action_channel_settings_short" data-action="settings" data-id={ ch.ChannelID }>@MaterialIcon("Settings", "")</button>
			<button class="channel-btn remove" type="button" title={ L(p, "action_unfollow", "Unfollow") } data-i18n-title="action_unfollow" data-optimistic-unfollow
				hx-delete={ "/api/unsubscribe/" + ch.ChannelID }
				hx-target="closest .channel-item"
				hx-swap="outerHTML"
				hx-confirm={ LF(p, "confirm_unfollow_channel_body", "Unfollow %1$s?", ch.Name) }
				>@MaterialIcon("PersonRemove", "")</button>
		</div>
	</div>
}

// SidebarStarButton renders a star/unstar button for the sidebar with HTMX.
templ SidebarStarButton(p PageProps, channelID string, isStarred bool) {
	if isStarred {
		<button class="channel-btn star active" type="button" title={ L(p, "action_unstar_channel", "Unstar channel") } data-i18n-title="action_unstar_channel"
			hx-post={ "/api/channels/" + channelID + "/star?ctx=sidebar" }
			hx-swap="outerHTML"
		>@MaterialIcon("Star", "")</button>
	} else {
		<button class="channel-btn star" type="button" title={ L(p, "action_star_channel", "Star channel") } data-i18n-title="action_star_channel"
			hx-post={ "/api/channels/" + channelID + "/star?ctx=sidebar" }
			hx-swap="outerHTML"
		>@MaterialIcon("StarBorder", "")</button>
	}
}

// SidebarVideoList renders a titled list of videos with a per-item progress bar.
templ SidebarVideoList(title string, videos []model.Video, p PrefsData) {
	<div class="sidebar-section-block">
		<h3 class="section-title">{ title }</h3>
		<div class="channel-list">
			for _, v := range videos {
				<div class="sidebar-video-item">
					<a href={ templ.SafeURL(fmt.Sprintf("/player/%s", v.VideoID)) } class="sidebar-video-link" title={ p.VideoTitle(v) }>
						<div class="sidebar-video-row">
							@MaterialIcon("PlayArrow", "sidebar-video-play")
							<div class="sidebar-video-title">{ p.VideoTitle(v) }</div>
						</div>
						<div class="sidebar-video-progress">
							<div class="sidebar-video-progress-fill" style={ fmt.Sprintf("width:%d%%", progressPercent(v.PlaybackPosition, v.Duration)) }></div>
						</div>
					</a>
				</div>
			}
		</div>
	</div>
}

// progressPercent converts playback position + duration (seconds) to an integer percent 0..100.
func progressPercent(position float64, duration int) int {
	if duration <= 0 || position <= 0 {
		return 0
	}
	pct := int((position / float64(duration)) * 100)
	if pct < 0 {
		return 0
	}
	if pct > 100 {
		return 100
	}
	return pct
}
