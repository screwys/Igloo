package components

import "net/url"

// TempDownloadPage renders the temp download / watch page wrapped in the Base layout.
templ TempDownloadPage(p PageProps, videoID string, youtubeURL string, videoTitle string, thumbnailURL string) {
	@Base(p) {
		<div class="temp-dl-page">
			<div class="temp-dl-card">
				<div
					id="temp-dl-config"
					data-video-id={ videoID }
					data-youtube-url={ youtubeURL }
					data-status-url={ "/api/temp-download-status?url=" + url.QueryEscape(youtubeURL) }
					data-title-cancelled={ L(p, "temp_download_title_cancelled", "Download cancelled") }
					data-status-cancelled={ L(p, "temp_download_status_cancelled", "Cancelled.") }
					data-action-back-to-videos={ L(p, "temp_download_action_back_to_videos", "Back to videos") }
					data-title-failed={ L(p, "temp_download_title_failed", "Download failed") }
					data-status-failed={ L(p, "temp_download_status_failed", "Download failed") }
					data-status-error-prefix={ L(p, "temp_download_status_error_prefix", "Error:") }
					style="display:none"
				></div>
				<div class="temp-dl-spinner" aria-hidden="true"></div>
				<h1 id="temp-dl-title">{ L(p, "temp_download_title_downloading", "Downloading...") }</h1>
				<div class="temp-dl-video">
					if thumbnailURL != "" {
						<img class="temp-dl-thumbnail" src={ thumbnailURL } alt=""/>
					}
					if videoTitle != "" {
						<p class="temp-dl-video-title">{ videoTitle }</p>
					}
					<p class="temp-dl-video-id" id="temp-dl-video-id">{ videoID }</p>
				</div>
				<p id="temp-dl-status" class="hidden" role="status"></p>
				<div id="temp-dl-actions" class="temp-dl-actions">
					<button type="button" id="temp-dl-download-btn" class="player-btn" title={ L(p, "action_download", "Download") } aria-label={ L(p, "action_download", "Download") } hidden>@MaterialIcon("Download", "")</button>
					<button type="button" id="temp-dl-stream-btn" class="player-btn" title={ L(p, "action_stream_instead", "Stream instead") } aria-label={ L(p, "action_stream_instead", "Stream instead") }>@MaterialIcon("PlayArrow", "")</button>
					<button type="button" id="temp-dl-cancel-btn" class="player-btn" title={ L(p, "action_cancel", "Cancel") } aria-label={ L(p, "action_cancel", "Cancel") }>@MaterialIcon("Close", "")</button>
				</div>
			</div>
		</div>
		<script defer src={ p.StaticV("js/temp_download.js") }></script>
	}
}
