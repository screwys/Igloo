package components

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"github.com/screwys/igloo/internal/db"
	"github.com/screwys/igloo/internal/model"
)

// BookmarkSelection holds the filters applied to the bookmark grid.
type BookmarkSelection struct {
	CategoryID int64
	PostedBy string
	Tagged string
	Label string
	IsNoLabel bool
	Query string
	SavedFrom string
	SavedThrough string
	TimeZone string
	OldestFirst bool
}

func (s BookmarkSelection) Active() bool {
	return s.CategoryID != 0 || s.PostedBy != "" || s.Tagged != "" || s.IsNoLabel || s.Label != "" || s.Query != "" || s.SavedFrom != "" || s.SavedThrough != "" || s.OldestFirst
}

type bookmarkFilterOption struct {
	Value string
	Name string
}

// BookmarksPage renders bookmark filters, cards, and the shorts overlay.
templ BookmarksPage(p PageProps, bookmarks []model.Video, categories []db.BookmarkCategoryRow, labelCounts []db.BookmarkLabelCountRow, postedBy []string, tagged []string, selected BookmarkSelection, pager model.Pager) {
	@Base(p) {
		<div class="bookmarks-filter-bar">
			<a class={ "bookmark-filter-pill", templ.KV("active", !selected.Active()) } href="/bookmarks">{ L(p, "logs_filter_all", "All") }</a>
			for _, cat := range categories {
				<a
					class={ "bookmark-filter-pill", templ.KV("active", selected.CategoryID == cat.ID) }
					href={ templ.SafeURL(bookmarkCategoryURL(selected, cat.ID)) }
				>{ cat.Name }</a>
			}
			@bookmarkFilters(p, categories, labelCounts, postedBy, tagged, selected)
		</div>
		<div id="shorts-grid-shell">
			<div id="video-grid" class="video-grid shorts-grid bookmarks-grid">
				if len(bookmarks) > 0 {
					for _, v := range bookmarks {
						@VideoCard(p, v)
					}
				} else {
					<div class="empty-state"><h3>{ L(p, "bookmarks_empty", "No bookmarks") }</h3></div>
				}
			</div>
			if pager.HasNext() {
				@VideoGridInfiniteScrollTrigger(bookmarksNextURL(pager, selected))
			}
		</div>
		<div
			id="shorts-layout"
			class="shorts-layout hidden"
			data-auto-open="0"
			data-persist-history="0"
			data-initial-page={ strconv.Itoa(bookmarksInitialPage(pager)) }
			data-page-size={ strconv.Itoa(bookmarksPageSize(pager)) }
			tabindex="-1"
		>
			<div class="shorts-stage">
				<div id="shorts-container" class="shorts-container"></div>
				<div id="shorts-uptodate-overlay" class="shorts-uptodate-overlay hidden" role="status" aria-live="polite">
					<div class="uptodate-content"><span>{ L(p, "status_up_to_date", "You're up to date!") }</span></div>
				</div>
			</div>
		</div>
	}
}

templ bookmarkFilters(p PageProps, categories []db.BookmarkCategoryRow, labels []db.BookmarkLabelCountRow, postedBy []string, tagged []string, selected BookmarkSelection) {
	<button class={ "bookmark-filter-pill", "bookmark-filter-toggle", templ.KV("active", selected.Active()) } type="button" aria-haspopup="dialog" aria-controls="bookmark-filters" title={ L(p, "bookmark_filters", "Filter") } aria-label={ L(p, "bookmark_filters", "Filter") } data-bookmark-filters-open>
		@MaterialIcon("FilterAlt", "")
	</button>
	<div id="bookmark-filters" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="bookmark-filters-title" aria-hidden="true">
		<div class="modal-backdrop"></div>
		<div class="modal-content bookmark-filters-content">
			<div class="modal-header">
				<h3 id="bookmark-filters-title">{ L(p, "bookmark_filters", "Filter") }</h3>
				<button class="modal-close" type="button" aria-label={ L(p, "action_close", "Close") }>@MaterialIcon("Close", "")</button>
			</div>
			<form action="/bookmarks" method="get" data-bookmark-filters-form>
				<div class="modal-body">
					<div class="bookmark-search-text">
						@MaterialIcon("Search", "")
						<input id="bookmark-search-query" class="bookmark-filter-input" type="search" name="q" placeholder={ L(p, "bookmark_search_text", "Search text") } aria-label={ L(p, "bookmark_search_text", "Search text") } data-bookmark-search-value value={ selected.Query }/>
					</div>
					<div class="bookmark-filter-row">
						@bookmarkFilterField(p, "category_id", L(p, "bookmark_filter_category", "Category"), strconv.FormatInt(selected.CategoryID, 10), bookmarkCategoryOptions(categories))
						@bookmarkFilterField(p, "label_choice", L(p, "bookmark_label", "Label"), bookmarkLabelValue(selected), bookmarkLabelOptions(p, labels))
					</div>
					<div class="bookmark-filter-row">
						@bookmarkFilterField(p, "posted_by", L(p, "bookmark_filter_posted_by", "Posted by"), selected.PostedBy, bookmarkAccountOptions(postedBy))
						@bookmarkFilterField(p, "tagged", L(p, "bookmark_filter_tagged", "Tagged"), selected.Tagged, bookmarkAccountOptions(tagged))
					</div>
					<div class="bookmark-filter-row">
						<div class="bookmark-filter-field">
							<label class="bookmark-filter-title" for="bookmark-saved-from">{ L(p, "bookmark_saved_from", "Saved from") }</label>
							<input id="bookmark-saved-from" class="bookmark-filter-input" type="date" name="saved_from" data-bookmark-search-value value={ selected.SavedFrom }/>
						</div>
						<div class="bookmark-filter-field">
							<label class="bookmark-filter-title" for="bookmark-saved-through">{ L(p, "bookmark_saved_through", "Saved through") }</label>
							<input id="bookmark-saved-through" class="bookmark-filter-input" type="date" name="saved_through" data-bookmark-search-value value={ selected.SavedThrough }/>
						</div>
					</div>
					<div class="bookmark-filter-field" role="radiogroup" aria-labelledby="bookmark-sort-title">
						<span id="bookmark-sort-title" class="bookmark-filter-title">{ L(p, "bookmark_sort", "Sort") }</span>
						<div class="bookmark-filter-sort">
							<label class="bookmark-filter-pill"><input type="radio" name="sort" value="" checked?={ !selected.OldestFirst }/>{ L(p, "bookmark_sort_newest", "Newest saved") }</label>
							<label class="bookmark-filter-pill"><input type="radio" name="sort" value="oldest" checked?={ selected.OldestFirst }/>{ L(p, "bookmark_sort_oldest", "Oldest saved") }</label>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-secondary" type="button" data-bookmark-filters-reset>{ L(p, "bookmark_filter_reset", "Reset") }</button>
					<button class="btn btn-primary" type="submit">{ L(p, "bookmark_filter_apply", "Apply") }</button>
				</div>
			</form>
		</div>
	</div>
}

templ bookmarkFilterField(p PageProps, name string, title string, selected string, options []bookmarkFilterOption) {
	<div class="bookmark-filter-field" data-bookmark-filter-field>
		<label class="bookmark-filter-title" for={ "bookmark-filter-" + name }>{ title }</label>
		<input type="hidden" name={ name } value={ selected }/>
		<div class="bookmark-filter-control">
			<input id={ "bookmark-filter-" + name } class="bookmark-filter-input" type="search" value={ bookmarkFilterDisplay(selected, options) } placeholder={ L(p, "logs_filter_all", "All") } autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls={ "bookmark-filter-options-" + name } aria-expanded="false" data-bookmark-filter-search/>
			@MaterialIcon("ArrowDropDown", "")
		</div>
		<div id={ "bookmark-filter-options-" + name } class="bookmark-filter-options hidden" popover="manual" role="listbox">
			<button type="button" class="bookmark-filter-option" role="option" tabindex="-1" aria-selected="false" data-value="" data-name="">{ L(p, "logs_filter_all", "All") }</button>
			for index, option := range options {
				<button id={ fmt.Sprintf("bookmark-filter-%s-%d", name, index) } type="button" class="bookmark-filter-option" role="option" tabindex="-1" aria-selected={ strconv.FormatBool(option.Value == selected) } data-value={ option.Value } data-name={ option.Name }>{ option.Name }</button>
			}
			<div class="bookmark-filter-empty hidden">{ L(p, "bookmark_filter_no_matches", "No matches") }</div>
		</div>
	</div>
}

func bookmarkCategoryOptions(categories []db.BookmarkCategoryRow) []bookmarkFilterOption {
	options := make([]bookmarkFilterOption, 0, len(categories))
	for _, category := range categories {
		options = append(options, bookmarkFilterOption{strconv.FormatInt(category.ID, 10), category.Name})
	}
	return options
}

func bookmarkAccountOptions(accounts []string) []bookmarkFilterOption {
	options := make([]bookmarkFilterOption, 0, len(accounts))
	for _, account := range accounts {
		options = append(options, bookmarkFilterOption{account, account})
	}
	return options
}

func bookmarkLabelOptions(p PageProps, labels []db.BookmarkLabelCountRow) []bookmarkFilterOption {
	options := make([]bookmarkFilterOption, 0, len(labels))
	for _, label := range labels {
		if label.IsNoLabel {
			options = append(options, bookmarkFilterOption{"empty", L(p, "bookmark_filter_no_label", "No label")})
		} else {
			options = append(options, bookmarkFilterOption{"label:" + label.Label, label.Label})
		}
	}
	return options
}

func bookmarkLabelValue(selected BookmarkSelection) string {
	if selected.IsNoLabel { return "empty" }
	if selected.Label != "" { return "label:" + selected.Label }
	return ""
}

func bookmarkFilterDisplay(value string, options []bookmarkFilterOption) string {
	for _, option := range options {
		if option.Value == value { return option.Name }
	}
	return ""
}

// BookmarksPartial renders just the bookmark cards and next trigger for HTMX infinite scroll responses.
templ BookmarksPartial(p PageProps, bookmarks []model.Video, pager model.Pager, selected BookmarkSelection) {
	for _, v := range bookmarks {
		@VideoCard(p, v)
	}
	if pager.HasNext() {
		@VideoGridInfiniteScrollTrigger(bookmarksNextURL(pager, selected))
	}
}

func bookmarksNextURL(pager model.Pager, selected BookmarkSelection) string {
	values := bookmarkFilterValues(selected)
	values.Set("page", strconv.Itoa(pager.Page+1))
	return "/bookmarks?" + values.Encode()
}

func bookmarkCategoryURL(selected BookmarkSelection, categoryID int64) string {
	selected.CategoryID = categoryID
	return "/bookmarks?" + bookmarkFilterValues(selected).Encode()
}

func bookmarkFilterValues(selected BookmarkSelection) url.Values {
	values := url.Values{}
	if selected.Query != "" { values.Set("q", selected.Query) }
	if selected.OldestFirst { values.Set("sort", "oldest") }
	if selected.SavedFrom != "" { values.Set("saved_from", selected.SavedFrom) }
	if selected.SavedThrough != "" { values.Set("saved_through", selected.SavedThrough) }
	if selected.SavedFrom != "" || selected.SavedThrough != "" { values.Set("tz", selected.TimeZone) }
	if selected.CategoryID > 0 { values.Set("category_id", strconv.FormatInt(selected.CategoryID, 10)) }
	if selected.PostedBy != "" { values.Set("posted_by", selected.PostedBy) }
	if selected.Tagged != "" { values.Set("tagged", selected.Tagged) }
	if selected.IsNoLabel {
		values.Set("label_empty", "1")
	} else if label := strings.TrimSpace(selected.Label); label != "" {
		values.Set("label", label)
	}
	return values
}

func bookmarksInitialPage(pager model.Pager) int {
	if pager.Page > 0 {
		return pager.Page
	}
	return 1
}

func bookmarksPageSize(pager model.Pager) int {
	if pager.PerPage > 0 {
		return pager.PerPage
	}
	return 200
}
