#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

while IFS= read -r git_env_var; do
  unset "$git_env_var"
done < <(git rev-parse --local-env-vars)

if [[ "${IGLOO_PRE_PUSH_FULL:-0}" == "1" ]]; then
  echo "pre-push: running scripts/dev/test-full.sh"
  scripts/dev/test-full.sh
  exit 0
fi

tested_range=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    remote_sha="$(git merge-base "$local_sha" origin/main)"
  fi
  echo "pre-push: testing changes from ${remote_sha:0:12} to ${local_sha:0:12}"
  GOCACHE="${GOCACHE:-$repo_root/.local/go-cache}" \
    IGLOO_ANDROID_CLEAN=1 \
    IGLOO_ANDROID_NO_DAEMON=1 \
    IGLOO_ANDROID_RERUN_TASKS=1 \
    IGLOO_TEST_BASE="$remote_sha" \
    IGLOO_TEST_HEAD="$local_sha" \
    scripts/dev/test-changed.sh
  tested_range=1
done

if [[ "$tested_range" == "0" ]]; then
  echo "pre-push: no updated refs"
fi
