<?xml version="1.0" encoding="utf-8"?>
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="Body" Height="-12" Weight="500" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="Title" Height="-28" Weight="600" Foreground="windowtext">Segoe UI</Font>
    <Font Id="Header" Height="-21" Weight="600" Foreground="windowtext">Segoe UI</Font>
    <Font Id="Muted" Height="-11" Weight="400" Foreground="graytext" Background="window">Segoe UI</Font>
    <Font Id="Label" Height="-12" Weight="600" Foreground="windowtext" Background="window">Segoe UI</Font>
    <Font Id="Active" Height="-12" Weight="700" Foreground="2e2e8b" Background="window">Segoe UI</Font>

    <Window Width="740" Height="550" HexStyle="100a0000" FontId="Body" Caption="Igloo Setup">
        <ImageControl X="24" Y="20" Width="64" Height="64" ImageFile="logo.png" Visible="yes" />
        <Label X="104" Y="22" Width="-24" Height="36" FontId="Title" DisablePrefix="yes">Igloo</Label>
        <Static X="184" Y="96" Width="1" Height="-64" />

        <Page Name="Loading">
            <Label X="210" Y="112" Width="-28" Height="36" FontId="Header" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>

        <Page Name="Help">
            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="210" Y="148" Width="-28" Height="-52" FontId="Body" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Install">
            <Label X="24" Y="115" Width="150" Height="24" FontId="Active" DisablePrefix="yes">1  License</Label>
            <Label X="24" Y="147" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">2  Run mode</Label>
            <Label X="24" Y="179" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">3  Storage</Label>
            <Label X="24" Y="211" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">4  Updates</Label>

            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">License Agreement</Label>
            <Label X="210" Y="148" Width="-28" Height="48" FontId="Body" DisablePrefix="yes">Please review the license terms before installing Igloo.</Label>
            <Hyperlink Name="EulaHyperlink" X="210" Y="204" Width="-28" Height="26" FontId="Body" TabStop="yes">View license agreement</Hyperlink>
            <Checkbox Name="EulaAcceptCheckbox" X="210" Y="252" Width="-28" Height="26" TabStop="yes" FontId="Label">I accept the terms in the License Agreement</Checkbox>
            <Label Name="InstallVersion" X="24" Y="-57" Width="260" Height="20" FontId="Muted" DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>
            <Button Name="LicenseNextButton" X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body" EnableCondition="EulaAcceptCheckbox">
                <Text>Next</Text>
                <ChangePageAction Page="RunModePage" />
            </Button>
            <Button Name="InstallCancelButton" X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body">
                <Text>Cancel</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="RunModePage">
            <Label X="24" Y="115" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  License</Label>
            <Label X="24" Y="147" Width="150" Height="24" FontId="Active" DisablePrefix="yes">2  Run mode</Label>
            <Label X="24" Y="179" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">3  Storage</Label>
            <Label X="24" Y="211" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">4  Updates</Label>

            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Run mode</Label>
            <RadioButtons Name="RunMode">
                <RadioButton X="210" Y="156" Width="-28" Height="26" Value="0" FontId="Label">System service</RadioButton>
                <RadioButton X="210" Y="212" Width="-28" Height="26" Value="1" FontId="Label">User service</RadioButton>
                <RadioButton X="210" Y="268" Width="-28" Height="26" Value="2" FontId="Label">Manual</RadioButton>
            </RadioButtons>
            <Label X="234" Y="182" Width="-28" Height="24" FontId="Muted" DisablePrefix="yes">(Recommended for servers)</Label>
            <Label X="234" Y="238" Width="-28" Height="24" FontId="Muted" DisablePrefix="yes">(Starts at user login)</Label>
            <Label X="234" Y="294" Width="-28" Height="24" FontId="Muted" DisablePrefix="yes">(Starts only when you run the program)</Label>
            <Button X="-234" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body">
                <Text>Back</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body">
                <Text>Next</Text>
                <ChangePageAction Page="Storage" />
            </Button>
            <Button X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body">
                <Text>Cancel</Text>
                <CloseWindowAction />
            </Button>
        </Page>

        <Page Name="Storage">
            <Label X="24" Y="115" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  License</Label>
            <Label X="24" Y="147" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  Run mode</Label>
            <Label X="24" Y="179" Width="150" Height="24" FontId="Active" DisablePrefix="yes">3  Storage</Label>
            <Label X="24" Y="211" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">4  Updates</Label>

            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Storage</Label>
            <Label X="210" Y="144" Width="-28" Height="40" FontId="Muted" DisablePrefix="yes">For the best experience, you can put the data folder in your fastest disk. Media directory can work on a slower disk.</Label>
            <Label X="210" Y="194" Width="-28" Height="22" FontId="Label" DisablePrefix="yes">Application directory</Label>
            <Editbox Name="InstallFolder" X="210" Y="218" Width="-120" Height="28" TabStop="yes" FontId="Body" FileSystemAutoComplete="yes" />
            <Button Name="BrowseButton" X="-28" Y="218" Width="84" Height="28" TabStop="yes" FontId="Body"><Text>Browse…</Text><BrowseDirectoryAction VariableName="InstallFolder" /></Button>
            <Label X="210" Y="254" Width="-28" Height="22" FontId="Label" DisablePrefix="yes">Data directory</Label>
            <Editbox Name="DataDirectory" X="210" Y="278" Width="-120" Height="28" TabStop="yes" FontId="Body" FileSystemAutoComplete="yes" />
            <Button X="-28" Y="278" Width="84" Height="28" TabStop="yes" FontId="Body"><Text>Browse…</Text><BrowseDirectoryAction VariableName="DataDirectory" /></Button>
            <Label X="210" Y="314" Width="-28" Height="22" FontId="Label" DisablePrefix="yes">Media directory</Label>
            <Editbox Name="MediaDirectory" X="210" Y="338" Width="-120" Height="28" TabStop="yes" FontId="Body" FileSystemAutoComplete="yes" />
            <Button X="-28" Y="338" Width="84" Height="28" TabStop="yes" FontId="Body"><Text>Browse…</Text><BrowseDirectoryAction VariableName="MediaDirectory" /></Button>
            <Button X="-234" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Back</Text><ChangePageAction Page="RunModePage" /></Button>
            <Button X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body"><Text>Next</Text><ChangePageAction Page="Updates" /></Button>
            <Button X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Cancel</Text><CloseWindowAction /></Button>
        </Page>

        <Page Name="Updates">
            <Label X="24" Y="115" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  License</Label>
            <Label X="24" Y="147" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  Run mode</Label>
            <Label X="24" Y="179" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  Storage</Label>
            <Label X="24" Y="211" Width="150" Height="24" FontId="Active" DisablePrefix="yes">4  Updates</Label>

            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Updates and shortcuts</Label>
            <Checkbox Name="AutomaticUpdates" X="210" Y="160" Width="-28" Height="26" TabStop="yes" FontId="Body">Install updates automatically</Checkbox>
            <Checkbox Name="DesktopShortcut" X="210" Y="208" Width="-28" Height="26" TabStop="yes" FontId="Body">Create a desktop shortcut</Checkbox>
            <Button X="-234" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Back</Text><ChangePageAction Page="Storage" /></Button>
            <Button Name="InstallButton" X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body" ElevationShieldCondition="NOT WixBundleElevated">Install</Button>
            <Button X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Cancel</Text><CloseWindowAction /></Button>
        </Page>

        <Page Name="Progress">
            <Label X="24" Y="115" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  License</Label>
            <Label X="24" Y="147" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  Run mode</Label>
            <Label X="24" Y="179" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  Storage</Label>
            <Label X="24" Y="211" Width="150" Height="24" FontId="Muted" DisablePrefix="yes">✓  Updates</Label>
            <Label X="24" Y="243" Width="150" Height="24" FontId="Active" DisablePrefix="yes">5  Install</Label>
            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Installing Igloo</Label>
            <Label Name="OverallProgressPackageText" X="210" Y="158" Width="-28" Height="24" FontId="Body" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Label Name="ExecuteProgressActionDataText" X="210" Y="186" Width="-28" Height="26" FontId="Muted" DisablePrefix="yes" />
            <Progressbar Name="OverallCalculatedProgressbar" X="210" Y="220" Width="-28" Height="20" />
            <Button Name="ProgressCancelButton" X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body">#(loc.ProgressCancelButton)</Button>
        </Page>

        <Page Name="Modify">
            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Igloo is installed</Label>
            <Button Name="ModifyUpdateButton" X="210" Y="164" Width="180" Height="32" TabStop="yes" FontId="Body" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="RepairButton" X="210" Y="208" Width="180" Height="32" TabStop="yes" FontId="Body" HideWhenDisabled="yes">Repair</Button>
            <Button X="210" Y="252" Width="180" Height="32" TabStop="yes" FontId="Body"><Text>Uninstall…</Text><ChangePageAction Page="UninstallOptions" /></Button>
            <Button Name="ModifyCancelButton" X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Close</Text><CloseWindowAction /></Button>
        </Page>

        <Page Name="UninstallOptions">
            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Uninstall Igloo</Label>
            <RadioButtons Name="UninstallMode">
                <RadioButton X="210" Y="160" Width="-28" Height="26" Value="0" FontId="Label">Keep data and settings</RadioButton>
                <RadioButton X="210" Y="218" Width="-28" Height="26" Value="1" FontId="Label">Remove application data</RadioButton>
                <RadioButton X="210" Y="282" Width="-28" Height="26" Value="2" FontId="Label">Remove everything</RadioButton>
            </RadioButtons>
            <Label X="234" Y="244" Width="-28" Height="32" FontId="Muted" DisablePrefix="yes">Keeps media, settings, and uploaded cookies.</Label>
            <Label X="234" Y="308" Width="-28" Height="48" FontId="Muted" DisablePrefix="yes">Deletes data, media, settings, and uploaded cookies.</Label>
            <Button X="-234" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Back</Text><ChangePageAction Page="Modify" /></Button>
            <Button Name="UninstallButton" X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body" ElevationShieldCondition="NOT WixBundleElevated">Uninstall</Button>
            <Button X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Cancel</Text><CloseWindowAction /></Button>
        </Page>

        <Page Name="Success">
            <Label X="210" Y="112" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 3">Uninstall complete</Text>
                <Text Condition="WixBundleAction = 5">Installation complete</Text>
                <Text Condition="WixBundleAction = 7">Repair complete</Text>
            </Label>
            <Label X="-24" Y="-64" Width="430" Height="36" FontId="Muted" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
            <Button Name="LaunchButton" X="-170" Y="-24" Width="144" Height="28" TabStop="yes" FontId="Body" HideWhenDisabled="yes" VisibleCondition="WixBundleAction &lt;&gt; 3">Finish and launch</Button>
            <Button Name="SuccessRestartButton" X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Finish</Text><CloseWindowAction /></Button>
        </Page>

        <Page Name="Failure">
            <Label X="210" Y="104" Width="-28" Height="36" FontId="Header" DisablePrefix="yes">Installation failed</Label>
            <Hypertext Name="FailureLogFileLink" X="210" Y="154" Width="-28" Height="44" FontId="Body" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="210" Y="204" Width="-28" Height="64" FontId="Body" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="-24" Y="-64" Width="430" Height="36" FontId="Muted" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-130" Y="-24" Width="102" Height="28" TabStop="yes" FontId="Body" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-24" Y="-24" Width="92" Height="28" TabStop="yes" FontId="Body"><Text>Close</Text><CloseWindowAction /></Button>
        </Page>
    </Window>
</Theme>
